# Copy to .env.local and fill in. Never commit real values (public repository).

# Supabase: for local development, use the values printed by `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared secret that Vercel Cron sends to /api/keep-alive (any long random string).
CRON_SECRET=

# Optional BoardGameGeek XML API token. Without it, Games are added by hand.
BGG_TOKEN=

# Only read by scripts/bootstrap-admin.mjs, never by the app.
ADMIN_EMAIL=
SUPABASE_DB_URL=

# Read by `pnpm supabase start` to enable Google sign-in locally (optional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
